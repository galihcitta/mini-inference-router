{
  "name": "mini-inference-router",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "minisearch": "7.2.0",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
